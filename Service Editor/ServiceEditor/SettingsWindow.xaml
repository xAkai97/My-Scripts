<ui:FluentWindow x:Class="ServiceEditor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Settings" Height="540" Width="550" MinWidth="550"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner">

    <Grid Background="{ui:ThemeResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" />

        <Grid Grid.Row="1" Margin="24,10,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Application Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    
                    <CheckBox x:Name="ChkRunOnStartup" Content="Run on Windows Startup (minimizes to tray)" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkGlobalToasts" Content="Enable Toast Notifications globally" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="When clicking the Close (X) button:" Margin="0,0,0,8" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    <ComboBox x:Name="CmbCloseBehavior" Width="250" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <ComboBoxItem Content="Ask me every time"/>
                        <ComboBoxItem Content="Minimize to System Tray"/>
                        <ComboBoxItem Content="Exit completely"/>
                    </ComboBox>

                    <TextBlock Text="Appearance Theme:" Margin="0,0,0,8" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    <ComboBox x:Name="CmbTheme" Width="250" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <ComboBoxItem Content="Auto (System Default)"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark (Mica Gray)"/>
                        <ComboBoxItem Content="Pure Dark (Solid Black)"/>
                    </ComboBox>

                    <TextBlock Text="Registry Backup" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    
                    <CheckBox x:Name="ChkAutoBackup" Content="Automatically create .reg backup when new services are added" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:Button Content="Backup All Services Now" Appearance="Primary" Click="BtnBackupAll_Click" Margin="0,0,10,0"/>
                        <ui:Button Content="Restore Service Backup" Click="BtnRestore_Click" Margin="0,0,10,0"/>
                        <ui:Button Content="Open Backups Folder" Click="BtnOpenBackups_Click"/>
                    </StackPanel>
                    <TextBlock Text="* Note: Original startup states are always auto-saved internally for safety." FontStyle="Italic" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <ui:Button Content="Cancel" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <ui:Button Content="Save" Appearance="Primary" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
