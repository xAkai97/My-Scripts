<ui:FluentWindow x:Class="ServiceEditor.ServiceScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ServiceEditor"
        Title="Service Scan List" Height="600" Width="900"
        MinWidth="600" MinHeight="400"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Available Windows Services" />

        <!-- Top Controls -->
        <WrapPanel Grid.Row="1" Margin="24,10,24,10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox x:Name="SearchBox" 
                            PlaceholderText="Search by service name or display name..." 
                            Width="300" 
                            Icon="Search24"
                            TextChanged="SearchBox_TextChanged"
                            Margin="0,0,16,0"/>

                <!-- Stats Badges -->
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total: " Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotal" Text="0" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Added: " Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAdded" Text="0" Foreground="#10B981" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ui:Button Content="Refresh List" 
                           Icon="ArrowClockwise24" 
                           Click="BtnRefresh_Click"
                           Margin="8,0,0,0"/>
            </StackPanel>
        </WrapPanel>

        <!-- DataGrid View -->
        <ui:DataGrid Grid.Row="2" 
                     x:Name="ScanGrid" 
                     AutoGenerateColumns="False" 
                     CanUserAddRows="False"
                     HeadersVisibility="Column"
                     GridLinesVisibility="Horizontal"
                     Background="Transparent"
                     BorderThickness="0"
                     RowHeaderWidth="0"
                     Margin="24,0,24,24">
            <ui:DataGrid.Columns>
                <!-- Service Name Column -->
                <DataGridTextColumn Header="Service Name" Binding="{Binding Name}" Width="200" IsReadOnly="True" />
                
                <!-- Display Name Column -->
                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" />
                
                <!-- Status Column -->
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True" />

                <!-- Add/Remove Controls -->
                <DataGridTemplateColumn Header="Action" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Show ADD button when not added -->
                                <ui:Button Content="Add" 
                                           Icon="Add24" 
                                           Appearance="Primary"
                                           Click="BtnAddService_Click"
                                           Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" 
                                           HorizontalAlignment="Center" />
                                           
                                <!-- Show REMOVE button when added -->
                                <ui:Button Content="Remove" 
                                           Icon="Delete24" 
                                           Appearance="Danger"
                                           Click="BtnRemoveService_Click"
                                           Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}}" 
                                           HorizontalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</ui:FluentWindow>
