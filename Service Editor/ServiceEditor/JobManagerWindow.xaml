<ui:FluentWindow x:Class="ServiceEditor.JobManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Job Manager" Height="600" Width="800" MinWidth="750" MinHeight="520"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner">

    <Grid Background="{ui:ThemeResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Job Manager" />

        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Configured Jobs List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Configured Jobs" FontWeight="Bold" FontSize="16" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>
                
                <ListBox x:Name="LstJobs" Grid.Row="1" SelectionChanged="LstJobs_SelectionChanged" Background="{ui:ThemeResource ControlFillColorDefaultBrush}" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"/>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button Content="Add Job" Appearance="Primary" Click="BtnAddJob_Click" Margin="0,0,10,0"/>
                    <ui:Button Content="Delete" Appearance="Danger" Click="BtnDeleteJob_Click"/>
                </StackPanel>
            </Grid>

            <!-- Job Details (Enabled only when a job is selected) -->
            <Grid Grid.Column="2" x:Name="GridDetails" IsEnabled="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Job Details" FontWeight="Bold" FontSize="16" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Job Name:" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="TxtJobName" TextChanged="JobData_Changed" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Linked Executable (e.g. vmware.exe):" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="TxtExecutable" TextChanged="JobData_Changed" Margin="0,0,0,15"/>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Shutdown Delay (seconds):" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,5"/>
                            <ui:NumberBox x:Name="NumDelay" ValueChanged="NumDelay_ValueChanged" Width="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="ChkAutoStart" Content="Auto Start/Stop in Background" IsChecked="True" Checked="JobData_Changed" Unchecked="JobData_Changed" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,5"/>
                            <CheckBox x:Name="ChkToasts" Content="Enable Toast Notifications" IsChecked="True" Checked="JobData_Changed" Unchecked="JobData_Changed" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="Associated Services:" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,5"/>
                </StackPanel>
                
                <ListBox x:Name="LstServices" Grid.Row="1" SelectionMode="Multiple" Background="{ui:ThemeResource ControlFillColorDefaultBrush}" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}" SelectionChanged="JobData_Changed"/>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <ui:Button Content="Create Desktop Shortcut" Click="BtnShortcut_Click" Margin="0,0,10,0"/>
                    <ui:Button Content="Start Job Now" Appearance="Primary" Click="BtnStartJob_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Global Action Buttons (Always Enabled) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
            <ui:Button Content="Cancel" Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <ui:Button Content="Save Jobs" Appearance="Success" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
