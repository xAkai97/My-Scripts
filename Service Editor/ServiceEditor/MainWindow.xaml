<ui:FluentWindow x:Class="ServiceEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ServiceEditor"
        Title="Service Management Tool" Height="680" Width="1100"
        MinWidth="800" MinHeight="500"
        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <local:GroupExpansionConverter x:Key="GroupExpansionConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="WrapHeaderTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>



        <ContextMenu x:Key="RowContextMenu">
            <MenuItem Header="Select All" Click="MenuSelectAll_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="CheckmarkSquare24"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Deselect All" Click="MenuDeselectAll_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Square24"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Select by Category" Click="MenuSelectByCategory_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Deselect by Category" Click="MenuDeselectByCategory_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Folder24"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Start Service" Click="MenuStartIndividual_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Play24" Foreground="#10B981"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Stop Service" Click="MenuStopIndividual_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Stop24" Foreground="#EF4444"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Expand All Categories" Click="MenuExpandAll_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ChevronDown24"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Collapse All Categories" Click="MenuCollapseAll_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ChevronUp24"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Expand by Category" Click="MenuExpandByCategory_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Collapse by Category" Click="MenuCollapseByCategory_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Folder24"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>


    </ui:FluentWindow.Resources>

    <Window.InputBindings>
        <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding ImportCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ServiceListCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding ManageCategoriesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="J" Modifiers="Ctrl" Command="{Binding ManageJobsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F12" Command="{Binding LogsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F4" Command="{Binding SettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F1" Command="{Binding HotkeysCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Q" Modifiers="Ctrl" Command="{Binding QuitCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DeselectAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Esc" Command="{Binding ClearSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Windows Service Editor" />

        <!-- Top Menu Bar -->
        <Menu Grid.Row="1" Background="Transparent" Padding="12,0" Margin="20,0,0,10">
            <MenuItem Header="_File">
                <MenuItem Header="_Import Config" Click="MenuImport_Click" InputGestureText="Ctrl+I" />
                <MenuItem Header="_Export Config" Click="MenuExport_Click" InputGestureText="Ctrl+E" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="E_xit" Click="MenuExit_Click" InputGestureText="Ctrl+Q" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Select _All" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A" />
                <MenuItem Header="_Deselect All" Command="{Binding DeselectAllCommand}" InputGestureText="Ctrl+D" />
                <Separator />
                <MenuItem Header="_Service List" Click="MenuServiceList_Click" InputGestureText="Ctrl+L" />
                <MenuItem Header="_Manage Categories" Click="MenuManageCategories_Click" InputGestureText="Ctrl+M" />
                <MenuItem Header="_Manage Jobs" Click="MenuManageJobs_Click" InputGestureText="Ctrl+J" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" InputGestureText="F5" />
                <MenuItem Header="_Clear Search" Command="{Binding ClearSearchCommand}" InputGestureText="Esc" />
                <Separator />
                <MenuItem Header="_Logs" Click="MenuLogs_Click" InputGestureText="F12" />
            </MenuItem>
            <MenuItem Header="_Settings" Click="MenuSettings_Click" InputGestureText="F4" />
            <MenuItem Header="_Help">
                <MenuItem Header="_Hotkeys Info" Click="MenuHotkeys_Click" InputGestureText="F1" />
            </MenuItem>
        </Menu>

        <!-- Main Workspace -->
        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Dashboard Control Panel -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20" VerticalAlignment="Center">

                <!-- Stats and Search (First Row) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <!-- Stats Badges -->
                    <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total: " Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTotal" Text="0" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Running: " Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtRunning" Text="0" Foreground="#10B981" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mismatch: " Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtMismatch" Text="0" Foreground="#EF4444" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ui:TextBox x:Name="SearchBox" 
                                PlaceholderText="Search services or categories..." 
                                Width="500" 
                                Icon="Search24"
                                TextChanged="SearchBox_TextChanged"
                                Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Action Buttons (Second Row) -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ui:Button Content="Add Job" 
                               Icon="Add24" 
                               Appearance="Secondary"
                               Click="MenuManageJobs_Click"
                               ToolTip="Add or manage automated service jobs"
                               Margin="0,0,8,0"/>

                    <ui:Button Content="Refresh" 
                               Icon="ArrowClockwise24" 
                               Click="BtnRefresh_Click"
                               ToolTip="Refresh live status from Windows Services"
                               Margin="0,0,8,0"/>
                    
                    <ui:DropDownButton Content="Start" 
                                       Icon="Play24" 
                                       Appearance="Secondary"
                                       Margin="0,0,8,0">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="Start Selected" Click="BtnStartSelected_Click" />
                                <MenuItem Header="Start All" Click="BtnStartAll_Click" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <ui:DropDownButton Content="Stop" 
                                       Icon="Stop24" 
                                       Appearance="Secondary"
                                       Margin="0,0,8,0">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="Stop Selected" Click="BtnStopSelected_Click" />
                                <MenuItem Header="Stop All" Click="BtnStopAll_Click" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <ui:DropDownButton Content="Apply" 
                                       Icon="Checkmark24" 
                                       Appearance="Secondary"
                                       Margin="0,0,8,0">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="Apply Selected" Click="BtnApplySelected_Click" />
                                <MenuItem Header="Apply All" Click="BtnApplyAll_Click" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <ui:Button Content="Save to Windows" 
                               Icon="Save24" 
                               Appearance="Primary"
                               Click="BtnApplyConfig_Click"
                               ToolTip="Saves and enforces your configured settings to the Windows Registry for all managed services"/>
                </WrapPanel>
            </StackPanel>

            <!-- DataGrid View -->
            <ui:DataGrid Grid.Row="1" 
                         x:Name="ServicesGrid" 
                         AutoGenerateColumns="False" 
                         CanUserAddRows="False"
                         HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         Background="Transparent"
                         BorderThickness="0"
                         RowHeaderWidth="0"
                         RowDetailsVisibilityMode="Collapsed"
                         CellEditEnding="ServicesGrid_CellEditEnding"
                         PreviewMouseRightButtonUp="ServicesGrid_PreviewMouseRightButtonUp"
                         PreviewMouseLeftButtonDown="ServicesGrid_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="ServicesGrid_PreviewMouseLeftButtonUp"
                         MouseMove="ServicesGrid_MouseMove"
                         Drop="ServicesGrid_Drop"
                         DragOver="ServicesGrid_DragOver"
                         DragLeave="ServicesGrid_DragLeave"
                         AllowDrop="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.ScrollUnit="Pixel">
                <ui:DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="{Binding Name, Converter={StaticResource GroupExpansionConverter}, Mode=OneWay}" 
                                                      Expanded="GroupExpander_Expanded"
                                                      Collapsed="GroupExpander_Collapsed"
                                                      Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                                      BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                      BorderThickness="1"
                                                      Margin="0,0,0,10">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                        <ui:SymbolIcon Symbol="Folder24" Filled="True" Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" Margin="8,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ui:DataGrid.GroupStyle>
                <ui:DataGrid.Columns>
                    <!-- Drag Handle Column -->
                    <DataGridTemplateColumn x:Name="ColDragHandle" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:SymbolIcon x:Name="DragIcon" Symbol="ReOrder24" Tag="DragHandle" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Cursor="SizeAll" ToolTip="Drag to rearrange" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Selection Column -->
                    <DataGridTemplateColumn x:Name="ColSelection" Width="Auto" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          PreviewMouseLeftButtonDown="CheckBox_PreviewMouseLeftButtonDown"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                                          ToolTip="Select this service for batch operations"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Warning / Mismatch Column -->
                    <DataGridTemplateColumn x:Name="ColMismatch" Width="Auto" Header="" HeaderTemplate="{StaticResource WrapHeaderTemplate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:SymbolIcon x:Name="MismatchIcon"
                                               Symbol="Warning24" 
                                               Filled="True" 
                                               Foreground="#F59E0B" 
                                               ToolTip="Configuration settings mismatch! The live Windows setting differs from the expected app setting."
                                               Visibility="{Binding IsMismatched, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding MismatchSeverity}" Value="Error">
                                        <Setter TargetName="MismatchIcon" Property="Foreground" Value="#EF4444" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MismatchSeverity}" Value="Warning">
                                        <Setter TargetName="MismatchIcon" Property="Foreground" Value="#F59E0B" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn x:Name="ColServiceName" Header="Service Name" Binding="{Binding Name}" Width="Auto" IsReadOnly="True" HeaderTemplate="{StaticResource WrapHeaderTemplate}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="The internal Windows Service name" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn x:Name="ColCategory" Header="Category" Width="Auto" HeaderTemplate="{StaticResource WrapHeaderTemplate}" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category}" VerticalAlignment="Center" Margin="12,0" ToolTip="Group category for this service"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}" 
                                          ItemsSource="{Binding DataContext.AvailableCategories, RelativeSource={RelativeSource AncestorType=Window}}" 
                                          Margin="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn x:Name="ColOriginalMode" Header="Original" Binding="{Binding OriginalStartupType}" Width="Auto" IsReadOnly="True" HeaderTemplate="{StaticResource WrapHeaderTemplate}" Visibility="Collapsed"/>
                    
                    <DataGridTextColumn x:Name="ColCurrentMode" Header="Current" Binding="{Binding CurrentStartupType}" Width="Auto" IsReadOnly="True" HeaderTemplate="{StaticResource WrapHeaderTemplate}"/>

                    <!-- Config Startup Mode -->
                    <DataGridTemplateColumn x:Name="ColSetMode" Header="Set" Width="Auto" HeaderTemplate="{StaticResource WrapHeaderTemplate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StartupType}" VerticalAlignment="Center" Margin="12,0" ToolTip="The desired startup state (Automatic, Manual, Disabled)"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox SelectedValuePath="Content" SelectedValue="{Binding StartupType, UpdateSourceTrigger=PropertyChanged}" Margin="0">
                                    <ComboBoxItem Content="Automatic" />
                                    <ComboBoxItem Content="Manual" />
                                    <ComboBoxItem Content="Disabled" />
                                    <ComboBoxItem Content="Boot" />
                                    <ComboBoxItem Content="System" />
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn x:Name="ColLinkedPrograms" Header="Linked Programs" Binding="{Binding LinkedProgramsString, UpdateSourceTrigger=PropertyChanged}" Width="Auto" IsReadOnly="False" HeaderTemplate="{StaticResource WrapHeaderTemplate}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="Executable programs associated with this service (e.g. game.exe)" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Service Location Column -->
                    <DataGridTextColumn x:Name="ColServiceLocation" Header="Service Location" Binding="{Binding ServiceLocation}" Width="Auto" IsReadOnly="True" HeaderTemplate="{StaticResource WrapHeaderTemplate}" Visibility="Collapsed">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="File path to the service executable" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Live Status Column with Custom Pills -->
                    <DataGridTemplateColumn x:Name="ColStatus" Header="Status" Width="Auto" HeaderTemplate="{StaticResource WrapHeaderTemplate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Name="StatusBorder" ToolTip="Current status of the service in Windows" Background="#6B7280">
                                    <TextBlock Text="{Binding CurrentStatus}" FontWeight="SemiBold" FontSize="11" Foreground="White" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStatus}" Value="Running">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="#10B981" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStatus}" Value="Stopped">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="#4B5563" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStatus}" Value="NotFound">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="#991B1B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStatus}" Value="Unknown">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="#374151" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStatus}" Value="StartPending">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="#F59E0B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStatus}" Value="StopPending">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="#F59E0B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStatus}" Value="Paused">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="#F59E0B" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Managed Configuration Column -->
                    <DataGridTemplateColumn x:Name="ColManaged" Header="Managed" Width="95" HeaderTemplate="{StaticResource WrapHeaderTemplate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" 
                                          Checked="ManagedCheck_Changed"
                                          Unchecked="ManagedCheck_Changed"
                                          HorizontalAlignment="Center"
                                          ToolTip="Check this box to allow Service Editor to manage and enforce settings for this service"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Row Actions Column -->
                    <DataGridTemplateColumn x:Name="ColControls" Header="Controls" Width="200" HeaderTemplate="{StaticResource WrapHeaderTemplate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:Button Content="Apply" 
                                               Icon="Checkmark24" 
                                               Click="BtnApplyIndividual_Click"
                                               ToolTip="Apply set startup type to this service"
                                               Margin="0,0,4,0"/>
                                    <ui:Button Content="Start" 
                                               Icon="Play24" 
                                               Click="BtnStartIndividual_Click"
                                               ToolTip="Start this individual service"
                                               Margin="0,0,4,0"/>
                                    <ui:Button Content="Stop" 
                                               Icon="Stop24" 
                                               ToolTip="Stop this individual service"
                                               Click="BtnStopIndividual_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>

                <ui:DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Expander Header="Service Dependencies" Margin="10,5" IsExpanded="False" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Depends On:" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" ToolTip="This service cannot start unless these services are running."/>
                                        <ItemsControl ItemsSource="{Binding DependsOn}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="5,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DependsOn.Count}" Value="0">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate>
                                                                        <TextBlock Text="None" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" FontStyle="Italic" Margin="5,2"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Required By:" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" ToolTip="These services depend on this service. If you stop this, they will fail to start."/>
                                        <ItemsControl ItemsSource="{Binding RequiredBy}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="5,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RequiredBy.Count}" Value="0">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate>
                                                                        <TextBlock Text="None" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" FontStyle="Italic" Margin="5,2"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                        </Expander>
                    </DataTemplate>
                </ui:DataGrid.RowDetailsTemplate>
            </ui:DataGrid>
        </Grid>

        <!-- Status Footer -->
        <StatusBar Grid.Row="3" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" Padding="12,6">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
