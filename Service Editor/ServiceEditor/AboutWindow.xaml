<ui:FluentWindow x:Class="ServiceEditor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="About Service Editor" Height="300" Width="400"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="About" />

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="WindowApps24" FontSize="64" Margin="0,0,0,10" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            
            <TextBlock Text="Service Editor" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            
            <TextBlock x:Name="TxtVersion" Text="Version 1.0.0" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            
            <TextBlock Text="A tool to easily manage and toggle Windows services." FontSize="14" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>

            <ui:Button Content="Close" HorizontalAlignment="Center" Width="100" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
